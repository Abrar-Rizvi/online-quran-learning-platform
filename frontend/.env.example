# Backend API URL (used server-side for data fetching)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional, server-only: backend URL for server-to-server admin calls (login + /admin/*).
# Set it when the Next.js server should reach the backend on a different (e.g. private) address.
# Falls back to NEXT_PUBLIC_API_URL when unset.
API_URL=

# Optional, server-only: IANA time zone for admin dates and weekly/daily stats
# (e.g. Asia/Karachi, America/New_York). Backend timestamps are UTC. Defaults to UTC.
ADMIN_TIME_ZONE=

# WhatsApp number shown in navbar/footer contact links (optional)
# Include country code, e.g. +1 718 666-7828
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact email shown in footer (optional)
NEXT_PUBLIC_CONTACT_EMAIL=
