{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "/bin/sh -c \"exec /app/.venv/bin/uvicorn backend.main:app --app-dir src --host 0.0.0.0 --port $PORT --no-proxy-headers\"",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
