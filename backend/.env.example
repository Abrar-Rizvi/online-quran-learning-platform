# Backend environment variables (copy to .env for local dev; set in Railway for production).
# Never commit real values.

# "development" shows /docs and allows http://localhost:3000 in CORS, and only warns about
# weak secrets. Anything else — including unset — is treated as "production".
APP_ENV=development

# Required. Neon pooled connection string (sslmode=require).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Admin sign-in. In production the app refuses to start unless ADMIN_USERNAME is set,
# ADMIN_PASSWORD has at least 12 characters and JWT_SECRET_KEY at least 32.
ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_SECRET_KEY=

# CORS: exact site origin(s), no trailing slash. ALLOWED_ORIGINS is comma-separated.
FRONTEND_URL=https://quranclass.us
ALLOWED_ORIGINS=https://www.quranclass.us

# Set true behind Railway's proxy (rate limits use the right-most X-Forwarded-For entry).
TRUST_PROXY_HEADERS=false

# Course search embeddings (GET /courses/search).
GEMINI_API_KEY=

# Chatbot (POST /chat) — keep CHAT_ENABLED false until the chat is hardened.
CHAT_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
REGISTRATION_FORM_URL=
WHATSAPP_LINK=
